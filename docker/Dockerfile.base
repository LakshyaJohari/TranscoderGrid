FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    ninja-build \
    git \
    ffmpeg \
    libprotobuf-dev \
    protobuf-compiler \
    protobuf-compiler-grpc \
    libgrpc++-dev \
    libspdlog-dev \
    nlohmann-json3-dev \
    libgtest-dev \
    libgmock-dev \
    libsqlite3-dev \
    pkg-config \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install header-only CLI11 if not packaged
RUN git clone --depth 1 https://github.com/CLIUtils/CLI11.git /tmp/cli11 && \
    cp -r /tmp/cli11/include/CLI /usr/local/include/ && \
    rm -rf /tmp/cli11

WORKDIR /app
